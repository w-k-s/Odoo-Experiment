# Docker Compose env for the loyalty-backend service.
# Copy to .env.docker (gitignored) and fill in secrets. Unlike backend/.env,
# addresses here use the in-network compose service names, not localhost.
DATABASE_URL=postgres://loyalty:loyalty_password@loyalty-postgres:5432/loyalty
BIND_ADDR=0.0.0.0:8000
POOL_MAX_SIZE=8
BOOTSTRAP_PROGRAM_NAME=UAE Bakery Rewards
RUST_LOG=info,loyalty_backend=debug

# Auth0 — verify the ID token. AUTH0_AUDIENCE is the SPA client id (the token's `aud`).
AUTH0_DOMAIN=wks-bakery.eu.auth0.com
AUTH0_AUDIENCE=jrvgFWjBsJQVleaJuVumT2NAffwZDQzv

# Odoo JSON-RPC — dedicated bot user (or admin) + API key (see README).
ODOO_URL=http://odoo:8069
ODOO_DB=odoo
ODOO_LOGIN=admin
ODOO_API_KEY=
