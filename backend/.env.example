# Copy to .env for local (non-docker) runs. In docker compose these are
# provided via the service `environment:` block instead.
DATABASE_URL=postgres://loyalty:loyalty_password@localhost:5433/loyalty
BIND_ADDR=0.0.0.0:8000
POOL_MAX_SIZE=8
BOOTSTRAP_PROGRAM_NAME=UAE Bakery Rewards
RUST_LOG=info,loyalty_backend=debug

# Auth0 — verify the ID token. AUTH0_AUDIENCE is the SPA client id (the token's `aud`).
AUTH0_DOMAIN=wks-bakery.eu.auth0.com
AUTH0_AUDIENCE=https://wks-bakery.eu.auth0.com/api/v2/

# Auth0 Management API M2M app (identity integration: resolve a member's profile
# by `sub`). The app must be authorized for the Management API with `read:users`.
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# Odoo JSON-RPC — use a dedicated bot user + API key (see backend README).
# For non-docker runs point ODOO_URL at the host-exposed Odoo (http://localhost:8069).
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_LOGIN=loyalty-bot
ODOO_API_KEY=
